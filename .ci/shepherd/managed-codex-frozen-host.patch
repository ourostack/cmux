+// Modified by Ouro: terminal wakeups must not depend on receiver registration order.
+#[cfg(test)]
+mod cmux_terminal_contract {
+    use super::*;
+    use std::future::Future;
+    use std::task::Poll;
+    use std::time::Duration;
+    use tokio::sync::mpsc;
+    use tokio::time::timeout;
+
+    #[tokio::test]
+    async fn cmux_terminal_trip_before_registration_is_observed() -> std::io::Result<()> {
+        let guard = FrozenConfigViolation::new();
+        let _ = guard.violate("test before registration");
+        timeout(Duration::from_secs(1), guard.wait_for_violation())
+            .await
+            .expect("terminal state was lost before subscription");
+        let (sender, mut receiver) = mpsc::channel(1);
+        assert!(guard
+            .until_violation("post-terminal send", async {
+                sender.send(1).await.map_err(std::io::Error::other)
+            })
+            .await
+            .is_err());
+        assert!(receiver.try_recv().is_err());
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn cmux_terminal_trip_wakes_all_blocked_sends() -> std::io::Result<()> {
+        let guard = FrozenConfigViolation::new();
+        let (sender, mut receiver) = mpsc::channel(1);
+        sender.send(0).await.map_err(std::io::Error::other)?;
+        let first = guard.until_violation("first blocked send", async {
+            sender.send(1).await.map_err(std::io::Error::other)
+        });
+        let second = guard.until_violation("second blocked send", async {
+            sender.send(2).await.map_err(std::io::Error::other)
+        });
+        tokio::pin!(first);
+        tokio::pin!(second);
+        assert!(std::future::poll_fn(|context| Poll::Ready(first.as_mut().poll(context)))
+            .await
+            .is_pending());
+        assert!(std::future::poll_fn(|context| Poll::Ready(second.as_mut().poll(context)))
+            .await
+            .is_pending());
+        let _ = guard.violate("test while both sends are pending");
+        let (first_result, second_result) = timeout(Duration::from_secs(1), async {
+            tokio::join!(first, second)
+        })
+        .await
+        .expect("one blocked sender did not wake");
+        for result in [first_result, second_result] {
+            assert_eq!(result.unwrap_err().kind(), std::io::ErrorKind::PermissionDenied);
+        }
+        assert_eq!(receiver.recv().await, Some(0));
+        assert!(receiver.try_recv().is_err());
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn cmux_terminal_closed_send_never_becomes_success() {
+        let guard = FrozenConfigViolation::new();
+        let (sender, receiver) = mpsc::channel::<u8>(1);
+        drop(receiver);
+        assert!(guard
+            .until_violation("closed send", async {
+                sender.send(1).await.map_err(std::io::Error::other)
+            })
+            .await
+            .is_err());
+        assert!(guard.is_violated());
+        timeout(Duration::from_secs(1), guard.wait_for_violation())
+            .await
+            .expect("terminal state after closure was lost");
+        assert!(guard.is_violated());
+    }
+}
