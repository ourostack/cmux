+// Modified by Ouro: only fixed text turns and current-thread inventory are public work.
+fn validate_frozen_work_request(
+    guard: &crate::config_manager::FrozenConfigViolation,
+    request: &ClientRequest,
+    owned_thread_id: &str,
+) -> IoResult<()> {
+    guard.check()?;
+    let admitted = match request {
+        ClientRequest::TurnStart { params, .. } => {
+            let codex_app_server_protocol::TurnStartParams {
+                thread_id,
+                client_user_message_id,
+                input,
+                turn_trigger,
+                tool_output,
+                responsesapi_client_metadata,
+                additional_context,
+                environments,
+                cwd,
+                runtime_workspace_roots,
+                approval_policy,
+                approvals_reviewer,
+                sandbox_policy,
+                permissions,
+                model,
+                service_tier,
+                service_tier_for_turn,
+                effort,
+                summary,
+                personality,
+                output_schema,
+                collaboration_mode,
+                multi_agent_mode,
+                cyber_access_program,
+            } = params;
+            thread_id == owned_thread_id
+                && client_user_message_id.is_none()
+                && matches!(
+                    input.as_slice(),
+                    [codex_app_server_protocol::UserInput::Text { text, text_elements }]
+                        if text.len() <= 65536 && text_elements.is_empty()
+                )
+                && turn_trigger.is_none()
+                && tool_output.is_none()
+                && responsesapi_client_metadata.is_none()
+                && additional_context.is_none()
+                && environments.as_ref().is_some_and(Vec::is_empty)
+                && cwd.is_none()
+                && runtime_workspace_roots.is_none()
+                && approval_policy.is_none()
+                && approvals_reviewer.is_none()
+                && sandbox_policy.is_none()
+                && permissions.is_none()
+                && model.is_none()
+                && service_tier.is_none()
+                && service_tier_for_turn.is_none()
+                && effort.is_none()
+                && summary.is_none()
+                && personality.is_none()
+                && output_schema.is_none()
+                && collaboration_mode.is_none()
+                && multi_agent_mode.is_none()
+                && cyber_access_program.is_none()
+        }
+        ClientRequest::ThreadBackgroundTerminalsList { params, .. } => {
+            let codex_app_server_protocol::ThreadBackgroundTerminalsListParams {
+                thread_id,
+                cursor: _,
+                limit,
+            } = params;
+            thread_id == owned_thread_id && limit.is_none_or(|value| value > 0)
+        }
+        _ => false,
+    };
+    if !admitted || owned_thread_id.is_empty() {
+        return Err(guard.violate("unsupported frozen work request"));
+    }
+    let frame = serde_json::to_vec(request).map_err(|error| {
+        let _ = guard.violate("frozen work request serialization failed");
+        IoError::new(ErrorKind::InvalidData, error)
+    })?;
+    if frame.len() > 2 * 1024 * 1024 {
+        return Err(guard.violate("frozen work request exceeds frame bound"));
+    }
+    Ok(())
+}
