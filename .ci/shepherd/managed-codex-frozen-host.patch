+struct FrozenState {
+    config: Arc<Config>,
+    guard: crate::config_manager::FrozenConfigViolation,
+    bootstrap: std::sync::Mutex<Option<FrozenBootstrap>>,
+    supervisor: std::sync::Mutex<Option<tokio::task::JoinHandle<IoResult<()>>>>,
+    ready: tokio::sync::watch::Sender<FrozenReady>,
+    attached: tokio::sync::watch::Sender<Option<String>>,
+    outgoing: std::sync::OnceLock<Arc<OutgoingMessageSender>>,
+    requests: mpsc::Sender<ProcessorCommand>,
+    registry: std::sync::Mutex<FrozenRegistry>,
+    native_tools: Vec<codex_app_server_protocol::DynamicToolSpec>,
+}
+
+struct FrozenAdmissionClaim {
+    guard: crate::config_manager::FrozenConfigViolation,
+    operation: &'static str,
+    completed: bool,
+}
+
+impl FrozenAdmissionClaim {
+    fn new(
+        guard: &crate::config_manager::FrozenConfigViolation,
+        operation: &'static str,
+    ) -> Self {
+        Self {
+            guard: guard.clone(),
+            operation,
+            completed: false,
+        }
+    }
+
+    fn complete(mut self) {
+        self.completed = true;
+    }
+}
+
+impl Drop for FrozenAdmissionClaim {
+    fn drop(&mut self) {
+        if !self.completed {
+            let _ = self.guard.violate(self.operation);
+        }
+    }
+}
+
+impl FrozenState {
+    fn registry(&self) -> IoResult<std::sync::MutexGuard<'_, FrozenRegistry>> {
+        self.registry
+            .lock()
+            .map_err(|_| self.guard.violate("frozen work registry poisoned"))
+    }
+
+    fn owned_thread(&self) -> IoResult<String> {
+        self.guard.check()?;
+        match &*self.ready.borrow() {
+            FrozenReady::Ready(response) => Ok(response.thread.id.clone()),
+            FrozenReady::Failed(kind, message) => Err(IoError::new(*kind, message.clone())),
+            FrozenReady::Pending => Err(IoError::new(
+                ErrorKind::WouldBlock,
+                "frozen app-server has not completed its authorized bootstrap",
+            )),
+        }
+    }
+
+    fn trigger_bootstrap(self: &Arc<Self>) -> IoResult<()> {
+        self.guard.check()?;
+        let mut supervisor = self
+            .supervisor
+            .lock()
+            .map_err(|_| self.guard.violate("frozen supervisor lock poisoned"))?;
+        let bootstrap = self
+            .bootstrap
+            .lock()
+            .map_err(|_| self.guard.violate("frozen bootstrap lock poisoned"))?
+            .take();
+        if let Some(bootstrap) = bootstrap {
+            let state = Arc::clone(self);
+            let owner = FrozenAdmissionClaim::new(
+                &self.guard, "frozen supervisor abandoned or panicked",
+            );
+            *supervisor = Some(tokio::spawn(async move {
+                let _owner = owner;
+                run_frozen_generation(state, bootstrap).await
+            }));
+        }
+        Ok(())
+    }
+}
