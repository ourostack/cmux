+#[derive(Clone)]
+pub struct FrozenSender {
+    state: Arc<FrozenState>,
+}
+
+impl FrozenSender {
+    /// The first call explicitly authorizes the one captured bootstrap.
+    pub async fn wait_ready(&self) -> IoResult<Arc<codex_app_server_protocol::ThreadStartResponse>> {
+        self.state.trigger_bootstrap()?;
+        let mut ready = self.state.ready.subscribe();
+        loop {
+            self.state.guard.check()?;
+            match ready.borrow_and_update().clone() {
+                FrozenReady::Ready(response) => return Ok(response),
+                FrozenReady::Failed(kind, message) => return Err(IoError::new(kind, message)),
+                FrozenReady::Pending => {}
+            }
+            self.state
+                .guard
+                .until_violation("waiting for frozen readiness", async {
+                    ready.changed().await.map_err(IoError::other)
+                })
+                .await?;
+        }
+    }
+
+    pub async fn request(&self, request: ClientRequest) -> IoResult<PendingClientRequestResponse> {
+        let thread_id = self.state.owned_thread()?;
+        validate_frozen_work_request(&self.state.guard, &request, &thread_id)?;
+        let kind = match &request {
+            ClientRequest::TurnStart { .. } => FrozenRequestKind::TurnStart,
+            ClientRequest::ThreadBackgroundTerminalsList { .. } => FrozenRequestKind::ShellPage,
+            _ => return Err(self.state.guard.violate("unsupported frozen public request")),
+        };
+        self.request_captured(request, kind).await
+    }
+
+    async fn request_captured(
+        &self,
+        request: ClientRequest,
+        kind: FrozenRequestKind,
+    ) -> IoResult<PendingClientRequestResponse> {
+        self.state.guard.check()?;
+        let id = request.id().clone();
+        let (response, receive) = oneshot::channel();
+        {
+            let mut registry = self.state.registry()?;
+            if registry.requests.contains_key(&id) {
+                return Err(self.state.guard.violate("frozen request ID reused"));
+            }
+            registry.requests.insert(id.clone(), FrozenPendingRequest {
+                kind,
+                response: Some(response),
+            });
+            if kind == FrozenRequestKind::TurnStart {
+                registry.roots.insert(id, FrozenTurnRoot::default());
+            }
+        }
+        let claim = FrozenAdmissionClaim::new(
+            &self.state.guard,
+            "admitted frozen request cancelled before response",
+        );
+        self.state.guard.until_violation("frozen request queue", async {
+            self.state.requests.send(ProcessorCommand::Request(Box::new(request)))
+                .await.map_err(IoError::other)
+        }).await?;
+        let response = self.state.guard.until_violation("frozen response waiter", async {
+            receive.await.map_err(IoError::other)
+        }).await?;
+        if response.is_err() {
+            return Err(self.state.guard.violate("frozen request returned a protocol error"));
+        }
+        claim.complete();
+        Ok(response)
+    }
+
+    /// CONTROL never traverses the request, processor, router or event queues.
+    pub async fn respond_to_server_request(&self, response: FrozenNativeToolResponse) -> IoResult<()> {
+        self.state.guard.check()?;
+        let thread_id = self.state.owned_thread()?;
+        {
+            let mut registry = self.state.registry()?;
+            let pending = registry.callbacks.get_mut(&response.request_id)
+                .ok_or_else(|| self.state.guard.violate("unregistered frozen CONTROL response"))?;
+            if pending.phase != FrozenCallbackPhase::Registered
+                || pending.thread_id != thread_id
+                || pending.thread_id != response.thread_id
+                || pending.turn_id != response.turn_id
+                || pending.call_id != response.call_id
+            {
+                return Err(self.state.guard.violate("frozen CONTROL identity or phase mismatch"));
+            }
+            pending.phase = FrozenCallbackPhase::Claimed;
+        }
+        let claim = FrozenAdmissionClaim::new(
+            &self.state.guard,
+            "claimed frozen CONTROL cancelled before checked delivery",
+        );
+        let value = serde_json::to_value(response.result)
+            .map_err(|_| self.state.guard.violate("frozen CONTROL serialization failed"))?;
+        let outgoing = self.state.outgoing.get()
+            .ok_or_else(|| self.state.guard.violate("frozen CONTROL runtime unavailable"))?;
+        self.state.guard.until_violation("frozen checked CONTROL delivery", async {
+            outgoing.notify_frozen_client_response(
+                IN_PROCESS_CONNECTION_ID, response.request_id.clone(), value,
+            ).await
+        }).await?;
+        self.state.registry()?.callbacks.get_mut(&response.request_id)
+            .ok_or_else(|| self.state.guard.violate("frozen CONTROL accounting disappeared"))?
+            .phase = FrozenCallbackPhase::Delivered;
+        self.state.guard.check()?;
+        claim.complete();
+        Ok(())
+    }
+}
