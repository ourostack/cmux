+pub struct FrozenInProcessHandle {
+    sender: FrozenSender,
+    events: mpsc::Receiver<InProcessServerEvent>,
+}
+
+impl FrozenInProcessHandle {
+    pub fn sender(&self) -> FrozenSender {
+        self.sender.clone()
+    }
+
+    pub fn violation_guard(&self) -> crate::config_manager::FrozenConfigViolation {
+        self.sender.state.guard.clone()
+    }
+
+    pub async fn wait_ready(&self) -> IoResult<Arc<codex_app_server_protocol::ThreadStartResponse>> {
+        self.sender.wait_ready().await
+    }
+
+    pub async fn next_event(&mut self) -> IoResult<InProcessServerEvent> {
+        self.sender.state.guard.until_violation("frozen event receiver", async {
+            self.events.recv().await.ok_or_else(|| {
+                IoError::new(ErrorKind::BrokenPipe, "frozen event stream closed")
+            })
+        }).await
+    }
+
+    pub async fn shutdown(self) -> IoResult<()> {
+        let _ = self.sender.state.guard.violate("frozen host shutdown requested");
+        let supervisor = self.sender.state.supervisor.lock()
+            .map_err(|_| self.sender.state.guard.violate("frozen supervisor lock poisoned"))?
+            .take();
+        if let Some(mut supervisor) = supervisor {
+            match timeout(SHUTDOWN_ACK_TIMEOUT, &mut supervisor).await {
+                Ok(result) => result.map_err(IoError::other)?,
+                Err(error) => {
+                    // The supervisor remains owned and continues cleanup after this timeout.
+                    *self.sender.state.supervisor.lock()
+                        .map_err(|_| self.sender.state.guard.violate("frozen supervisor lock poisoned"))?
+                        = Some(supervisor);
+                    Err(IoError::new(ErrorKind::TimedOut, error))
+                }
+            }
+        } else {
+            Ok(())
+        }
+    }
+}
+
+impl Drop for FrozenInProcessHandle {
+    fn drop(&mut self) {
+        let _ = self.sender.state.guard.violate("frozen host owner dropped");
+    }
+}
+
+pub async fn start_frozen(args: FrozenInProcessStartArgs) -> IoResult<FrozenInProcessHandle> {
+    use codex_app_server_protocol::DynamicToolSpec;
+    use codex_app_server_protocol::InitializeCapabilities;
+    use codex_core::config::ThreadStoreConfig;
+
+    let invalid = |message| IoError::new(ErrorKind::InvalidInput, message);
+    let InitializeParams { client_info: _, capabilities } = &args.initialize;
+    let Some(InitializeCapabilities {
+        experimental_api,
+        request_attestation,
+        mcp_server_openai_form_elicitation,
+        opt_out_notification_methods,
+        extensions,
+    }) = capabilities else {
+        return Err(invalid("frozen initialize capabilities must be explicit"));
+    };
+    if !experimental_api || *request_attestation || *mcp_server_openai_form_elicitation
+        || opt_out_notification_methods.is_some() || extensions.is_some()
+    {
+        return Err(invalid("frozen initialize cannot disable evidence or enable extra ingress"));
+    }
+    let [DynamicToolSpec::Function(tool)] = args.native_tools.as_slice() else {
+        return Err(invalid("frozen native registry must contain exactly one fixed function"));
+    };
+    if tool.name.is_empty() || tool.defer_loading || !tool.input_schema.is_object() {
+        return Err(invalid("frozen native registry is not an immediate fixed function"));
+    }
+    if args.channel_capacity == 0
+        || args.channel_capacity > DEFAULT_IN_PROCESS_CHANNEL_CAPACITY
+        || serde_json::to_vec(&args.native_tools).map_err(IoError::other)?.len() > 2 * 1024 * 1024
+    {
+        return Err(invalid("frozen queue capacity or immutable registry exceeds its bound"));
+    }
+    args.config.auth_config().validate()?;
+    let manager = ConfigManager::new_frozen(Arc::clone(&args.config), args.arg0_paths.clone())?;
+    let guard = manager.frozen_violation_guard()
+        .ok_or_else(|| invalid("frozen manager did not retain its violation guard"))?;
+    let ThreadStoreConfig::InMemory { id } = &args.config.experimental_thread_store else {
+        return Err(invalid("frozen runtime requires an actual in-memory thread store"));
+    };
+    if id.is_empty() || id.len() > 256 || !id.is_ascii() {
+        return Err(invalid("frozen in-memory store identity is not bounded and explicit"));
+    }
+    static RESERVED: std::sync::OnceLock<std::sync::Mutex<HashSet<String>>> =
+        std::sync::OnceLock::new();
+    if !RESERVED.get_or_init(Default::default).lock()
+        .map_err(|_| invalid("frozen store identity registry poisoned"))?
+        .insert(id.clone())
+    {
+        return Err(invalid("frozen in-memory store identity was already reserved"));
+    }
+    let native_tools = args.native_tools.clone();
+    let (requests, receive) = mpsc::channel(args.channel_capacity);
+    let (events, event_rx) = mpsc::channel(args.channel_capacity);
+    let (ready, _) = tokio::sync::watch::channel(FrozenReady::Pending);
+    let (attached, _) = tokio::sync::watch::channel(None);
+    let state = Arc::new(FrozenState {
+        config: Arc::clone(&args.config),
+        guard,
+        bootstrap: std::sync::Mutex::new(Some(FrozenBootstrap {
+            args, manager, requests: receive, events,
+        })),
+        supervisor: std::sync::Mutex::new(None),
+        ready,
+        attached,
+        outgoing: std::sync::OnceLock::new(),
+        requests,
+        registry: std::sync::Mutex::new(FrozenRegistry::default()),
+        native_tools,
+    });
+    Ok(FrozenInProcessHandle {
+        sender: FrozenSender { state },
+        events: event_rx,
+    })
+}
+
+impl FrozenState {
+    fn deliver_response(&self, id: &RequestId, result: PendingClientRequestResponse) -> IoResult<()> {
+        self.guard.check()?;
+        let mut registry = self.registry()?;
+        let kind = registry.requests.get(id)
+            .ok_or_else(|| self.guard.violate("unmatched frozen response"))?.kind;
+        if let Ok(value) = &result {
+            if serde_json::to_vec(value).map_err(IoError::other)?.len() > 2 * 1024 * 1024 {
+                return Err(self.guard.violate("frozen response exceeds frame bound"));
+            }
+            if kind == FrozenRequestKind::TurnStart {
+                let response: codex_app_server_protocol::TurnStartResponse =
+                    serde_json::from_value(value.clone()).map_err(IoError::other)?;
+                if response.turn.id.is_empty()
+                    || registry.roots.iter().any(|(other_id, root)| {
+                        other_id != id && root.turn_id.as_ref() == Some(&response.turn.id)
+                    })
+                {
+                    return Err(self.guard.violate("frozen turn response identity is not fresh"));
+                }
+                let root = registry.roots.get_mut(id)
+                    .ok_or_else(|| self.guard.violate("frozen turn root disappeared"))?;
+                if root.turn_id.is_some()
+                    || root.early_turn_id.as_ref().is_some_and(|early| early != &response.turn.id)
+                {
+                    return Err(self.guard.violate("frozen early-event turn identity mismatch"));
+                }
+                root.turn_id = Some(response.turn.id);
+            }
+        }
+        let failed = result.is_err();
+        let response = registry.requests.get_mut(id)
+            .and_then(|pending| pending.response.take())
+            .ok_or_else(|| self.guard.violate("duplicate frozen response delivery"))?;
+        response.send(result)
+            .map_err(|_| self.guard.violate("frozen response consumer dropped after admission"))?;
+        if failed {
+            return Err(self.guard.violate("frozen processor reported a protocol failure"));
+        }
+        Ok(())
+    }
+
+    fn register_native_request(&self, request: &ServerRequest) -> IoResult<()> {
+        use codex_app_server_protocol::DynamicToolSpec;
+
+        self.guard.check()?;
+        let owned_thread = self.owned_thread()?;
+        let ServerRequest::DynamicToolCall { request_id, params } = request else {
+            return Err(self.guard.violate("unsupported frozen server request"));
+        };
+        let [DynamicToolSpec::Function(tool)] = self.native_tools.as_slice() else {
+            return Err(self.guard.violate("frozen native registry changed"));
+        };
+        if params.thread_id != owned_thread || params.namespace.is_some()
+            || params.tool != tool.name || params.turn_id.is_empty() || params.call_id.is_empty()
+            || serde_json::to_vec(request).map_err(IoError::other)?.len() > 2 * 1024 * 1024
+        {
+            return Err(self.guard.violate("frozen native request is outside the captured domain"));
+        }
+        let mut registry = self.registry()?;
+        if registry.callbacks.contains_key(request_id)
+            || registry.callbacks.values().any(|pending| {
+                pending.turn_id == params.turn_id && pending.call_id == params.call_id
+            })
+        {
+            return Err(self.guard.violate("frozen native callback identity reused"));
+        }
+        if !registry.roots.values().any(|root| root.turn_id.as_ref() == Some(&params.turn_id)) {
+            let mut unbound = registry.roots.values_mut().filter(|root| root.turn_id.is_none());
+            let root = unbound.next()
+                .ok_or_else(|| self.guard.violate("native callback has no admitted turn root"))?;
+            if unbound.next().is_some()
+                || root.early_turn_id.as_ref().is_some_and(|turn| turn != &params.turn_id)
+            {
+                return Err(self.guard.violate("native callback has ambiguous early turn attribution"));
+            }
+            root.early_turn_id = Some(params.turn_id.clone());
+        }
+        registry.callbacks.insert(request_id.clone(), FrozenPendingCallback {
+            thread_id: params.thread_id.clone(),
+            turn_id: params.turn_id.clone(),
+            call_id: params.call_id.clone(),
+            phase: FrozenCallbackPhase::Registered,
+        });
+        Ok(())
+    }
+}
+
+struct FrozenRuntime {
+    state: Arc<FrozenState>,
+    processor: Arc<MessageProcessor>,
+    session: Arc<ConnectionSessionState>,
+    tasks: tokio::task::JoinSet<IoResult<()>>,
+    analytics: codex_analytics::AnalyticsEventsClient,
+    _store: Arc<codex_thread_store::InMemoryThreadStore>,
+}
+
+fn spawn_frozen_pump(
+    tasks: &mut tokio::task::JoinSet<IoResult<()>>,
+    guard: &crate::config_manager::FrozenConfigViolation,
+    future: impl std::future::Future<Output = IoResult<()>> + Send + 'static,
+) {
+    let claim = FrozenAdmissionClaim::new(guard, "frozen pump exited or panicked");
+    tasks.spawn(async move {
+        let _claim = claim;
+        future.await
+    });
+}
+
+impl FrozenRuntime {
+    async fn construct(state: Arc<FrozenState>, bootstrap: FrozenBootstrap) -> IoResult<Self> {
+        use codex_core::config::ThreadStoreConfig;
+        use codex_thread_store::InMemoryThreadStore;
+        use codex_thread_store::InMemoryThreadStoreCalls;
+
+        let FrozenBootstrap { args, manager, requests, events } = bootstrap;
+        state.guard.check()?;
+        let ThreadStoreConfig::InMemory { id } = &args.config.experimental_thread_store else {
+            return Err(state.guard.violate("actual frozen store binding changed"));
+        };
+        let store = InMemoryThreadStore::for_id(id.clone());
+        let calls = state.guard.until_violation("checking actual frozen store", async {
+            Ok(store.calls().await)
+        }).await?;
+        if Arc::strong_count(&store) != 2 || calls != InMemoryThreadStoreCalls::default() {
+            return Err(state.guard.violate("actual frozen in-memory store is shared or previously used"));
+        }
+        let environment_manager = Arc::new(EnvironmentManager::without_environments(
+            args.config.http_client_factory(),
+        ));
+        let feedback = CodexFeedback::new();
+        let installation_id = state.guard.until_violation("resolving frozen installation", async {
+            resolve_installation_id(&args.config.codex_home).await
+        }).await?;
+        let auth_manager = state.guard.until_violation("loading frozen auth", async {
+            AuthManager::shared_from_config(args.config.as_ref(), args.enable_codex_api_key_env)
+                .await.map_err(IoError::other)
+        }).await?;
+        let capacity = args.channel_capacity;
+        let (outgoing_tx, outgoing_rx) = mpsc::channel(capacity);
+        let analytics = analytics_events_client_from_config(
+            Arc::clone(&auth_manager), args.config.as_ref(),
+        );
+        let outgoing = Arc::new(OutgoingMessageSender::new(outgoing_tx, analytics.clone()));
+        state.outgoing.set(Arc::clone(&outgoing))
+            .map_err(|_| state.guard.violate("frozen outgoing runtime already constructed"))?;
+        let (writer_tx, writer_rx) = mpsc::channel(capacity);
+        let initialized = Arc::new(AtomicBool::new(false));
+        let experimental = Arc::new(AtomicBool::new(false));
+        let mut connections = HashMap::new();
+        connections.insert(
+            IN_PROCESS_CONNECTION_ID,
+            OutboundConnectionState::new(
+                writer_tx,
+                Arc::clone(&initialized),
+                Arc::clone(&experimental),
+                Arc::new(RwLock::new(HashSet::new())),
+                None,
+            ),
+        );
+        let config_warnings = args.config.startup_warnings.iter().map(|warning| {
+            ConfigWarningNotification {
+                summary: warning.clone(),
+                details: None,
+                path: None,
+                range: None,
+            }
+        }).collect();
+        state.guard.check()?;
+        let processor = Arc::new(MessageProcessor::new(MessageProcessorArgs {
+            outgoing,
+            analytics_events_client: analytics.clone(),
+            arg0_paths: args.arg0_paths,
+            config: args.config,
+            config_manager: manager,
+            environment_manager,
+            feedback,
+            log_db: None,
+            state_db: None,
+            config_warnings,
+            session_source: args.session_source,
+            auth_manager,
+            installation_id,
+            code_mode_session_provider: None,
+            rpc_transport: AppServerRpcTransport::InProcess,
+            remote_control_handle: None,
+            plugin_startup_tasks: None,
+        }));
+        let session = Arc::new(ConnectionSessionState::new());
+        let (processor_tx, processor_rx) = mpsc::channel(capacity);
+        let mut tasks = tokio::task::JoinSet::new();
+        let request_state = Arc::clone(&state);
+        spawn_frozen_pump(&mut tasks, &state.guard, async move {
+            run_frozen_request_pump(request_state, requests, processor_tx).await
+        });
+        let writer_state = Arc::clone(&state);
+        spawn_frozen_pump(&mut tasks, &state.guard, async move {
+            run_frozen_writer_pump(writer_state, writer_rx, events).await
+        });
+        let processor_state = Arc::clone(&state);
+        let processor_task = Arc::clone(&processor);
+        let session_task = Arc::clone(&session);
+        spawn_frozen_pump(&mut tasks, &state.guard, async move {
+            run_frozen_processor_pump(
+                processor_state, processor_task, session_task,
+                processor_rx, initialized, experimental,
+            ).await
+        });
+        let router_state = Arc::clone(&state);
+        spawn_frozen_pump(&mut tasks, &state.guard, async move {
+            let (_shutdown, receive) = oneshot::channel();
+            router_state.guard.until_violation("frozen outbound router", async {
+                run_outbound_router(outgoing_rx, connections, receive).await;
+                Err(IoError::new(ErrorKind::BrokenPipe, "frozen outbound router exited"))
+            }).await
+        });
+        Ok(Self { state, processor, session, tasks, analytics, _store: store })
+    }
+
+    async fn initialize(
+        &self,
+        initialize: InitializeParams,
+        native_tools: Vec<codex_app_server_protocol::DynamicToolSpec>,
+    ) -> IoResult<Arc<codex_app_server_protocol::ThreadStartResponse>> {
+        let sender = FrozenSender { state: Arc::clone(&self.state) };
+        let response = sender.request_captured(
+            ClientRequest::Initialize { request_id: RequestId::Integer(-1), params: initialize },
+            FrozenRequestKind::Initialize,
+        ).await?.map_err(|error| IoError::new(ErrorKind::InvalidData, error.message))?;
+        let _: codex_app_server_protocol::InitializeResponse =
+            serde_json::from_value(response).map_err(IoError::other)?;
+        self.state.guard.until_violation("frozen initialized notification", async {
+            self.state.requests.send(ProcessorCommand::Notification(ClientNotification::Initialized))
+                .await.map_err(IoError::other)
+        }).await?;
+        let response = sender.request_captured(
+            ClientRequest::ThreadStart {
+                request_id: RequestId::Integer(-2),
+                params: codex_app_server_protocol::ThreadStartParams {
+                    model: None,
+                    model_provider: None,
+                    allow_provider_model_fallback: false,
+                    service_tier: None,
+                    cwd: None,
+                    runtime_workspace_roots: None,
+                    approval_policy: None,
+                    approvals_reviewer: None,
+                    sandbox: None,
+                    permissions: None,
+                    config: None,
+                    service_name: None,
+                    base_instructions: None,
+                    developer_instructions: None,
+                    personality: None,
+                    multi_agent_mode: None,
+                    ephemeral: None,
+                    history_mode: None,
+                    session_start_source: None,
+                    thread_source: None,
+                    project_id: None,
+                    environments: Some(Vec::new()),
+                    dynamic_tools: Some(native_tools),
+                    selected_capability_roots: Some(Vec::new()),
+                    mock_experimental_field: None,
+                    experimental_raw_events: false,
+                },
+            },
+            FrozenRequestKind::ThreadStart,
+        ).await?.map_err(|error| IoError::new(ErrorKind::InvalidData, error.message))?;
+        let response: codex_app_server_protocol::ThreadStartResponse =
+            serde_json::from_value(response).map_err(IoError::other)?;
+        if response.thread.id.is_empty()
+            || self.state.config.model.as_deref() != Some(response.model.as_str())
+            || response.model_provider != self.state.config.model_provider_id
+            || response.cwd != self.state.config.cwd
+            || response.approval_policy.clone().to_core() != self.state.config.permissions.approval_policy.value()
+            || response.approvals_reviewer.clone().to_core() != self.state.config.approvals_reviewer
+            || response.sandbox.to_core() != self.state.config.legacy_sandbox_policy()
+            || response.thread.ephemeral != self.state.config.ephemeral
+            || response.thread.cwd != self.state.config.cwd
+            || response.thread.model_provider != self.state.config.model_provider_id
+        {
+            return Err(self.state.guard.violate("actual frozen thread/start differs from sealed configuration"));
+        }
+        let mut attached = self.state.attached.subscribe();
+        loop {
+            let current = attached.borrow_and_update().clone();
+            if let Some(thread) = current {
+                if thread != response.thread.id {
+                    return Err(self.state.guard.violate("frozen attached thread differs from readiness"));
+                }
+                break;
+            }
+            self.state.guard.until_violation("waiting for actual frozen thread listener", async {
+                attached.changed().await.map_err(IoError::other)
+            }).await?;
+        }
+        self.state.guard.check()?;
+        Ok(Arc::new(response))
+    }
+
+    async fn shutdown(mut self) -> IoResult<()> {
+        // These are SDK task/drain results, never native command completion or OS teardown proof.
+        let _ = self.state.guard.violate("frozen runtime cleanup");
+        let mut task_failure = None;
+        match self.state.registry() {
+            Ok(mut registry) => {
+                for pending in registry.requests.values_mut() {
+                    if let Some(response) = pending.response.take()
+                        && response.send(Err(internal_error("frozen runtime held during shutdown"))).is_err()
+                    {
+                        warn!("frozen response waiter already closed; admitted work remains held");
+                    }
+                }
+            }
+            Err(error) => {
+                warn!(%error, "frozen work accounting unavailable during cleanup");
+                task_failure = Some(error);
+            }
+        }
+        if let Some(outgoing) = self.state.outgoing.get() {
+            outgoing.cancel_all_requests(Some(internal_error(
+                "frozen runtime held; native work remains unresolved",
+            ))).await;
+        }
+        while let Some(result) = self.tasks.join_next().await {
+            if let Err(error) = result {
+                warn!(%error, "frozen pump panicked; generation remains held");
+                if task_failure.is_none() {
+                    task_failure = Some(IoError::other(error));
+                }
+            }
+        }
+        self.processor.clear_runtime_references();
+        self.processor.cancel_active_login().await;
+        self.processor.connection_closed(IN_PROCESS_CONNECTION_ID, &self.session).await;
+        self.processor.clear_all_thread_listeners().await;
+        self.processor.drain_background_tasks().await;
+        self.processor.shutdown_threads().await;
+        self.analytics.flush().await;
+        match task_failure {
+            Some(error) => Err(error),
+            None => Ok(()),
+        }
+    }
+}
+
+async fn run_frozen_generation(state: Arc<FrozenState>, bootstrap: FrozenBootstrap) -> IoResult<()> {
+    let initialize = bootstrap.args.initialize.clone();
+    let native_tools = bootstrap.args.native_tools.clone();
+    let runtime = match FrozenRuntime::construct(Arc::clone(&state), bootstrap).await {
+        Ok(runtime) => runtime,
+        Err(error) => {
+            state.ready.send_replace(FrozenReady::Failed(error.kind(), error.to_string()));
+            let _ = state.guard.violate("frozen runtime construction failed");
+            return Err(error);
+        }
+    };
+    let mut bootstrap_failure = None;
+    match runtime.initialize(initialize, native_tools).await {
+        Ok(response) => {
+            match state.guard.check() {
+                Ok(()) => {
+                    state.ready.send_replace(FrozenReady::Ready(response));
+                    state.guard.wait_for_violation().await;
+                }
+                Err(error) => {
+                    state.ready.send_replace(FrozenReady::Failed(error.kind(), error.to_string()));
+                    bootstrap_failure = Some(error);
+                }
+            }
+        }
+        Err(error) => {
+            state.ready.send_replace(FrozenReady::Failed(error.kind(), error.to_string()));
+            let _ = state.guard.violate("frozen bootstrap failed");
+            bootstrap_failure = Some(error);
+        }
+    }
+    let cleanup = runtime.shutdown().await;
+    match bootstrap_failure {
+        Some(error) => {
+            if let Err(cleanup_error) = cleanup {
+                warn!(%cleanup_error, "frozen bootstrap cleanup also failed");
+            }
+            Err(error)
+        }
+        None => cleanup,
+    }
+}
+
+async fn run_frozen_request_pump(
+    state: Arc<FrozenState>,
+    mut requests: mpsc::Receiver<ProcessorCommand>,
+    processor: mpsc::Sender<ProcessorCommand>,
+) -> IoResult<()> {
+    state.guard.until_violation("frozen request pump", async {
+        loop {
+            let request = requests.recv().await.ok_or_else(|| {
+                IoError::new(ErrorKind::BrokenPipe, "frozen request input closed")
+            })?;
+            state.guard.check()?;
+            processor.send(request).await.map_err(IoError::other)?;
+        }
+    }).await
+}
+
+async fn run_frozen_writer_pump(
+    state: Arc<FrozenState>,
+    mut writer: mpsc::Receiver<QueuedOutgoingMessage>,
+    events: mpsc::Sender<InProcessServerEvent>,
+) -> IoResult<()> {
+    state.guard.until_violation("frozen outgoing pump", async {
+        loop {
+            let queued = writer.recv().await.ok_or_else(|| {
+                IoError::new(ErrorKind::BrokenPipe, "frozen outgoing writer closed")
+            })?;
+            state.guard.check()?;
+            match queued.message {
+                OutgoingMessage::Response(response) => {
+                    state.deliver_response(
+                        &response.id,
+                        serde_json::to_value(response.result).map_err(|error| {
+                            internal_error(format!("failed to serialize frozen response: {error}"))
+                        }),
+                    )?;
+                }
+                OutgoingMessage::Error(error) => {
+                    state.deliver_response(&error.id, Err(error.error))?;
+                }
+                OutgoingMessage::Request(request) => {
+                    state.register_native_request(&request)?;
+                    events.send(InProcessServerEvent::ServerRequest(Box::new(request)))
+                        .await.map_err(IoError::other)?;
+                }
+                OutgoingMessage::AppServerNotification(envelope) => {
+                    if serde_json::to_vec(&envelope.notification).map_err(IoError::other)?.len()
+                        > 2 * 1024 * 1024
+                    {
+                        return Err(state.guard.violate("frozen notification exceeds frame bound"));
+                    }
+                    match forward_in_process_notification(
+                        InProcessNotificationMode::Frozen, &events, envelope.notification,
+                    ).await {
+                        InProcessNotificationDelivery::Forwarded => {}
+                        InProcessNotificationDelivery::Dropped | InProcessNotificationDelivery::Closed => {
+                            return Err(state.guard.violate("frozen notification was not delivered"));
+                        }
+                    }
+                }
+            }
+            state.guard.check()?;
+            if let Some(complete) = queued.write_complete_tx {
+                complete.send(())
+                    .map_err(|_| state.guard.violate("frozen outgoing receipt consumer closed"))?;
+            }
+        }
+    }).await
+}
+
+async fn run_frozen_processor_pump(
+    state: Arc<FrozenState>,
+    processor: Arc<MessageProcessor>,
+    session: Arc<ConnectionSessionState>,
+    mut commands: mpsc::Receiver<ProcessorCommand>,
+    initialized: Arc<AtomicBool>,
+    experimental: Arc<AtomicBool>,
+) -> IoResult<()> {
+    let mut created = processor.thread_created_receiver();
+    state.guard.until_violation("frozen processor pump", async {
+        loop {
+            tokio::select! {
+                command = commands.recv() => {
+                    state.guard.check()?;
+                    match command {
+                        Some(ProcessorCommand::Request(request)) => {
+                            let was_initialized = session.initialized();
+                            processor.process_client_request(
+                                IN_PROCESS_CONNECTION_ID, *request, Arc::clone(&session), &initialized,
+                            ).await;
+                            state.guard.check()?;
+                            if !session.opted_out_notification_methods().is_empty() {
+                                return Err(state.guard.violate("frozen session opted out of evidence"));
+                            }
+                            experimental.store(session.experimental_api_enabled(), Ordering::Release);
+                            if !was_initialized && session.initialized() {
+                                processor.send_initialize_notifications().await;
+                            }
+                        }
+                        Some(ProcessorCommand::Notification(ClientNotification::Initialized)) => {
+                            processor.process_client_notification(ClientNotification::Initialized).await;
+                        }
+                        Some(ProcessorCommand::Notification(_)) => {
+                            return Err(state.guard.violate("unsupported frozen client notification"));
+                        }
+                        None => return Err(IoError::new(ErrorKind::BrokenPipe, "frozen processor input closed")),
+                    }
+                }
+                thread = created.recv() => {
+                    state.guard.check()?;
+                    let thread = thread.map_err(IoError::other)?;
+                    if state.attached.borrow().is_some() {
+                        return Err(state.guard.violate("frozen runtime created an additional thread"));
+                    }
+                    processor.try_attach_thread_listener(
+                        thread, vec![IN_PROCESS_CONNECTION_ID],
+                    ).await;
+                    state.guard.check()?;
+                    state.attached.send_replace(Some(thread.to_string()));
+                }
+            }
+        }
+    }).await
+}
