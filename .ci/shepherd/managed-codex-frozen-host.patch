+// Modified by Ouro: typed frozen work admission, without constructing a backend.
+#[cfg(test)]
+mod cmux_frozen_request_contract {
+    use super::*;
+    use codex_app_server_protocol::ThreadBackgroundTerminalsListParams;
+    use codex_app_server_protocol::ThreadStartParams;
+    use codex_app_server_protocol::TurnStartParams;
+    use codex_app_server_protocol::UserInput;
+
+    fn turn(text: String) -> ClientRequest {
+        ClientRequest::TurnStart {
+            request_id: RequestId::Integer(7),
+            params: TurnStartParams {
+                thread_id: "owned-thread".to_string(),
+                input: vec![UserInput::Text {
+                    text,
+                    text_elements: Vec::new(),
+                }],
+                environments: Some(Vec::new()),
+                ..TurnStartParams::default()
+            },
+        }
+    }
+
+    #[test]
+    fn cmux_frozen_work_preserves_literal_and_utf8_byte_boundary() {
+        for text in [
+            " literal\n\"quoted\"\\path\t\u{00e9} ".to_string(),
+            "\u{00e9}".repeat(32768),
+        ] {
+            let guard = crate::config_manager::FrozenConfigViolation::new_for_tests();
+            let request = turn(text.clone());
+            assert!(validate_frozen_work_request(&guard, &request, "owned-thread").is_ok());
+            let ClientRequest::TurnStart { params, .. } = request else {
+                unreachable!();
+            };
+            assert_eq!(
+                params.input,
+                vec![UserInput::Text {
+                    text,
+                    text_elements: Vec::new(),
+                }]
+            );
+            assert!(!guard.is_violated());
+        }
+        let guard = crate::config_manager::FrozenConfigViolation::new_for_tests();
+        assert!(validate_frozen_work_request(
+            &guard,
+            &turn("x".repeat(65537)),
+            "owned-thread",
+        )
+        .is_err());
+        assert!(guard.is_violated());
+    }
+
+    #[test]
+    fn cmux_frozen_work_rejects_presence_of_turn_overrides() {
+        let ClientRequest::TurnStart { params, .. } = turn("literal".to_string()) else {
+            unreachable!();
+        };
+        let base = serde_json::to_value(&params).unwrap();
+        let changes = [
+            ("clientUserMessageId", serde_json::json!("extra")),
+            ("turnTrigger", serde_json::json!("extra")),
+            ("responsesapiClientMetadata", serde_json::json!({})),
+            ("additionalContext", serde_json::json!({})),
+            ("cwd", serde_json::json!("/foreign")),
+            ("runtimeWorkspaceRoots", serde_json::json!([])),
+            ("approvalPolicy", serde_json::json!("never")),
+            ("approvalsReviewer", serde_json::json!("user")),
+            ("permissions", serde_json::json!("read-only")),
+            ("model", serde_json::json!("gpt-5.5")),
+            ("serviceTierForTurn", serde_json::json!("default")),
+            ("personality", serde_json::json!("none")),
+            ("outputSchema", serde_json::json!({})),
+        ];
+        for (field, value) in changes {
+            let guard = crate::config_manager::FrozenConfigViolation::new_for_tests();
+            let mut changed = base.clone();
+            changed[field] = value;
+            let params: TurnStartParams = serde_json::from_value(changed).unwrap();
+            let request = ClientRequest::TurnStart {
+                request_id: RequestId::Integer(7),
+                params,
+            };
+            assert!(
+                validate_frozen_work_request(&guard, &request, "owned-thread").is_err(),
+                "accepted turn override {field}"
+            );
+            assert!(guard.is_violated(), "{field}");
+        }
+        let guard = crate::config_manager::FrozenConfigViolation::new_for_tests();
+        let mut nested_null = params;
+        nested_null.service_tier = Some(None);
+        assert!(validate_frozen_work_request(
+            &guard,
+            &ClientRequest::TurnStart {
+                request_id: RequestId::Integer(7),
+                params: nested_null,
+            },
+            "owned-thread",
+        )
+        .is_err());
+    }
+
+    #[test]
+    fn cmux_frozen_work_requires_explicit_empty_environments_and_one_text_item() {
+        for mutation in 0..4 {
+            let guard = crate::config_manager::FrozenConfigViolation::new_for_tests();
+            let ClientRequest::TurnStart { mut params, .. } = turn("literal".to_string()) else {
+                unreachable!();
+            };
+            match mutation {
+                0 => params.environments = None,
+                1 => params.input.clear(),
+                2 => params.input.push(params.input[0].clone()),
+                3 => {
+                    params.input = vec![UserInput::Image {
+                        detail: None,
+                        url: "https://example.invalid/image".to_string(),
+                    }]
+                }
+                _ => unreachable!(),
+            }
+            assert!(validate_frozen_work_request(
+                &guard,
+                &ClientRequest::TurnStart {
+                    request_id: RequestId::Integer(7),
+                    params,
+                },
+                "owned-thread",
+            )
+            .is_err());
+            assert!(guard.is_violated());
+        }
+    }
+
+    #[test]
+    fn cmux_frozen_work_rejects_foreign_threads_and_public_thread_creation() {
+        let guard = crate::config_manager::FrozenConfigViolation::new_for_tests();
+        assert!(validate_frozen_work_request(
+            &guard,
+            &turn("literal".to_string()),
+            "foreign-thread",
+        )
+        .is_err());
+        let guard = crate::config_manager::FrozenConfigViolation::new_for_tests();
+        assert!(validate_frozen_work_request(
+            &guard,
+            &ClientRequest::ThreadStart {
+                request_id: RequestId::Integer(8),
+                params: ThreadStartParams::default(),
+            },
+            "owned-thread",
+        )
+        .is_err());
+    }
+
+    #[test]
+    fn cmux_frozen_shell_pages_are_current_thread_only() {
+        for thread_id in ["owned-thread", "foreign-thread"] {
+            let guard = crate::config_manager::FrozenConfigViolation::new_for_tests();
+            let request = ClientRequest::ThreadBackgroundTerminalsList {
+                request_id: RequestId::String("page-7".to_string()),
+                params: ThreadBackgroundTerminalsListParams {
+                    thread_id: thread_id.to_string(),
+                    cursor: Some("literal-cursor".to_string()),
+                    limit: Some(64),
+                },
+            };
+            assert_eq!(
+                validate_frozen_work_request(&guard, &request, "owned-thread").is_ok(),
+                thread_id == "owned-thread"
+            );
+        }
+    }
+}
