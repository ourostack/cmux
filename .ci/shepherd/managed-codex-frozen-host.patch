+/// Read-only terminal state shared by the owned frozen configuration generation.
+#[derive(Clone)]
+pub struct FrozenConfigViolation {
+    violated: Arc<AtomicBool>,
+    changed: tokio::sync::watch::Sender<bool>,
+}
+
+impl FrozenConfigViolation {
+    #[cfg(test)]
+    pub(crate) fn new_for_tests() -> Self {
+        Self::new()
+    }
+
+    fn new() -> Self {
+        let (changed, _) = tokio::sync::watch::channel(false);
+        Self {
+            violated: Arc::new(AtomicBool::new(false)),
+            changed,
+        }
+    }
+
+    pub fn is_violated(&self) -> bool {
+        self.violated.load(Ordering::Acquire)
+    }
+
+    pub(crate) async fn wait_for_violation(&self) {
+        let mut changes = self.changed.subscribe();
+        loop {
+            if self.is_violated() || *changes.borrow_and_update() {
+                return;
+            }
+            if changes.changed().await.is_err() {
+                let _ = self.violate("terminal notification channel closed");
+                return;
+            }
+        }
+    }
+
+    pub(crate) async fn until_violation<T>(
+        &self,
+        operation: &'static str,
+        future: impl std::future::Future<Output = std::io::Result<T>>,
+    ) -> std::io::Result<T> {
+        self.check()?;
+        tokio::select! {
+            biased;
+            _ = self.wait_for_violation() => Err(self.violate(operation)),
+            result = future => {
+                self.check()?;
+                match result {
+                    Ok(value) => Ok(value),
+                    Err(error) => {
+                        let _ = self.violate(operation);
+                        Err(error)
+                    }
+                }
+            }
+        }
+    }
+
+    pub(crate) fn check(&self) -> std::io::Result<()> {
+        if self.is_violated() {
+            Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "frozen configuration generation has a terminal violation",
+            ))
+        } else {
+            Ok(())
+        }
+    }
+
+    pub(crate) fn violate(&self, operation: &'static str) -> std::io::Error {
+        if !self.violated.swap(true, Ordering::AcqRel) {
+            warn!(operation, "frozen configuration operation refused; generation held");
+        }
+        self.changed.send_replace(true);
+        std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            "frozen configuration operation refused; generation held",
+        )
+    }
+}
+
+struct FrozenConfigState {
