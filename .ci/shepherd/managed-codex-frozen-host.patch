+#[cfg(test)]
+mod cmux_direct_mode_contract {
+    use super::*;
+    use codex_models_manager::model_info::model_info_from_slug;
+
+    #[tokio::test]
+    async fn cmux_direct_mode_explicit_direct_survives_both_availability_outcomes() {
+        let mut config = crate::config::test_config().await;
+        let model = ModelInfo {
+            tool_mode: Some(ToolMode::Direct),
+            ..model_info_from_slug("gpt-5.5")
+        };
+        for code_mode_only in [false, true] {
+            config
+                .features
+                .set_enabled(Feature::CodeModeOnly, code_mode_only)
+                .unwrap();
+            for code_mode in [false, true] {
+                config
+                    .features
+                    .set_enabled(Feature::CodeMode, code_mode)
+                    .unwrap();
+                for available in [false, true] {
+                    for no_fallback in [false, true] {
+                        config.code_mode.disable_in_process_fallback = no_fallback;
+                        assert_eq!(
+                            cmux_native_profile_tool_modes(&config, &model, available),
+                            (ToolMode::Direct, ToolMode::Direct)
+                        );
+                    }
+                }
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn cmux_direct_mode_uses_actual_precedence_and_fallback_rules() {
+        let mut config = crate::config::test_config().await;
+        for selector in [
+            None,
+            Some(ToolMode::Direct),
+            Some(ToolMode::CodeMode),
+            Some(ToolMode::CodeModeOnly),
+        ] {
+            let model = ModelInfo {
+                tool_mode: selector,
+                ..model_info_from_slug("gpt-5.5")
+            };
+            for code_mode_only in [false, true] {
+                config
+                    .features
+                    .set_enabled(Feature::CodeModeOnly, code_mode_only)
+                    .unwrap();
+                for code_mode in [false, true] {
+                    config
+                        .features
+                        .set_enabled(Feature::CodeMode, code_mode)
+                        .unwrap();
+                    let requested = match selector {
+                        Some(mode) => mode,
+                        None if code_mode_only => ToolMode::CodeModeOnly,
+                        None if code_mode => ToolMode::CodeMode,
+                        None => ToolMode::Direct,
+                    };
+                    for available in [false, true] {
+                        for no_fallback in [false, true] {
+                            config.code_mode.disable_in_process_fallback = no_fallback;
+                            let expected = match (requested, available, no_fallback) {
