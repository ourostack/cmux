+// Modified by Ouro: preserve ordinary forwarding through a channel-only test seam.
+enum InProcessNotificationMode {
+    Ordinary,
+    Frozen,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum InProcessNotificationDelivery {
+    Forwarded,
+    Dropped,
+    Closed,
+}
+
+async fn forward_in_process_notification(
+    mode: InProcessNotificationMode,
+    event_tx: &mpsc::Sender<InProcessServerEvent>,
+    notification: ServerNotification,
+) -> InProcessNotificationDelivery {
+    if matches!(mode, InProcessNotificationMode::Frozen)
+        || server_notification_requires_delivery(&notification)
+    {
+        if event_tx
+            .send(InProcessServerEvent::ServerNotification(Box::new(notification)))
+            .await
+            .is_err()
+        {
+            InProcessNotificationDelivery::Closed
+        } else {
+            InProcessNotificationDelivery::Forwarded
+        }
+    } else {
+        match event_tx.try_send(InProcessServerEvent::ServerNotification(Box::new(notification))) {
+            Ok(()) => InProcessNotificationDelivery::Forwarded,
+            Err(mpsc::error::TrySendError::Full(_)) => {
+                warn!("dropping in-process server notification (queue full)");
+                InProcessNotificationDelivery::Dropped
+            }
+            Err(mpsc::error::TrySendError::Closed(_)) => InProcessNotificationDelivery::Closed,
+        }
+    }
 }
 
