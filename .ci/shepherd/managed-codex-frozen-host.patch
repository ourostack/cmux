+// Modified by Ouro: controlled channel-only forwarding probes; no backend startup.
+#[cfg(test)]
+mod cmux_forward_contract {
+    use super::*;
+    use codex_app_server_protocol::ThreadNameUpdatedNotification;
+    use codex_app_server_protocol::ThreadQueueChangedNotification;
+    use std::future::Future;
+    use std::task::Poll;
+
+    fn ordinary(label: &str) -> ServerNotification {
+        ServerNotification::ThreadNameUpdated(ThreadNameUpdatedNotification {
+            thread_id: "owned-thread".to_string(),
+            thread_name: Some(label.to_string()),
+        })
+    }
+
+    fn label(event: InProcessServerEvent) -> String {
+        match event {
+            InProcessServerEvent::ServerNotification(notification) => match *notification {
+                ServerNotification::ThreadNameUpdated(update) => update.thread_name.unwrap(),
+                _ => panic!("expected exact ordinary notification"),
+            },
+            _ => panic!("expected exact server notification"),
+        }
+    }
+
+    async fn poll_once<F: Future>(future: std::pin::Pin<&mut F>) -> Poll<F::Output> {
+        let mut future = future;
+        std::future::poll_fn(|context| Poll::Ready(future.as_mut().poll(context))).await
+    }
+
+    #[tokio::test]
+    async fn cmux_normal_event_forwarding_compatibility() {
+        timeout(Duration::from_secs(2), async {
+            let (sender, mut receiver) = mpsc::channel(1);
+            assert_eq!(
+                forward_in_process_notification(
+                    InProcessNotificationMode::Ordinary,
+                    &sender,
+                    ordinary("empty"),
+                )
+                .await,
+                InProcessNotificationDelivery::Forwarded
+            );
+            assert_eq!(label(receiver.recv().await.unwrap()), "empty");
+            assert_eq!(
+                forward_in_process_notification(
+                    InProcessNotificationMode::Ordinary,
+                    &sender,
+                    ordinary("first"),
+                )
+                .await,
+                InProcessNotificationDelivery::Forwarded
+            );
+            assert_eq!(
+                forward_in_process_notification(
+                    InProcessNotificationMode::Ordinary,
+                    &sender,
+                    ordinary("dropped"),
+                )
+                .await,
+                InProcessNotificationDelivery::Dropped
+            );
+            assert_eq!(label(receiver.recv().await.unwrap()), "first");
+            assert!(matches!(receiver.try_recv(), Err(mpsc::error::TryRecvError::Empty)));
+
+            assert_eq!(
+                forward_in_process_notification(
+                    InProcessNotificationMode::Ordinary,
+                    &sender,
+                    ordinary("before-required"),
+                )
+                .await,
+                InProcessNotificationDelivery::Forwarded
+            );
+            let required = ServerNotification::ThreadQueueChanged(ThreadQueueChangedNotification {
+                thread_id: "owned-thread".to_string(),
+            });
+            let mut pending = Box::pin(forward_in_process_notification(
+                InProcessNotificationMode::Ordinary,
+                &sender,
+                required,
+            ));
+            assert!(poll_once(pending.as_mut()).await.is_pending());
+            assert_eq!(label(receiver.recv().await.unwrap()), "before-required");
+            assert_eq!(pending.await, InProcessNotificationDelivery::Forwarded);
+            assert!(matches!(
+                receiver.recv().await.unwrap(),
+                InProcessServerEvent::ServerNotification(notification)
+                    if matches!(*notification, ServerNotification::ThreadQueueChanged(_))
+            ));
+            drop(receiver);
+            assert_eq!(
+                forward_in_process_notification(
+                    InProcessNotificationMode::Ordinary,
+                    &sender,
+                    ordinary("closed"),
+                )
+                .await,
+                InProcessNotificationDelivery::Closed
+            );
+            assert_eq!(
+                forward_in_process_notification(
+                    InProcessNotificationMode::Ordinary,
+                    &sender,
+                    ServerNotification::ThreadQueueChanged(ThreadQueueChangedNotification {
+                        thread_id: "owned-thread".to_string(),
+                    }),
+                )
+                .await,
+                InProcessNotificationDelivery::Closed
+            );
+        })
+        .await
+        .expect("ordinary forwarding compatibility fixture exceeded its bound");
+    }
+
+    #[tokio::test]
+    async fn cmux_frozen_delivery_applies_backpressure() {
+        timeout(Duration::from_secs(2), async {
+            let (sender, mut receiver) = mpsc::channel(1);
+            assert_eq!(
+                forward_in_process_notification(
+                    InProcessNotificationMode::Frozen,
+                    &sender,
+                    ordinary("first"),
+                )
+                .await,
+                InProcessNotificationDelivery::Forwarded
+            );
+            let mut pending = Box::pin(forward_in_process_notification(
+                InProcessNotificationMode::Frozen,
+                &sender,
+                ordinary("second"),
+            ));
+            let observed = poll_once(pending.as_mut()).await;
+            assert!(
+                observed.is_pending(),
+                "CMUX_FROZEN_FORWARDING_BACKPRESSURE_REQUIRED: actual forwarding returned {observed:?} while capacity1 was full"
+            );
+            assert_eq!(label(receiver.recv().await.unwrap()), "first");
+            assert_eq!(pending.await, InProcessNotificationDelivery::Forwarded);
+            assert_eq!(label(receiver.recv().await.unwrap()), "second");
+        })
+        .await
+        .expect("forwarding backpressure fixture exceeded its bound");
+    }
+
+    #[tokio::test]
+    async fn cmux_frozen_delivery_reports_closed_consumer() {
+        timeout(Duration::from_secs(2), async {
+            let (sender, receiver) = mpsc::channel(1);
+            assert_eq!(
+                forward_in_process_notification(
+                    InProcessNotificationMode::Frozen,
+                    &sender,
+                    ordinary("first"),
+                )
+                .await,
+                InProcessNotificationDelivery::Forwarded
+            );
+            let mut pending = Box::pin(forward_in_process_notification(
+                InProcessNotificationMode::Frozen,
+                &sender,
+                ordinary("unconsumed"),
+            ));
+            assert!(poll_once(pending.as_mut()).await.is_pending());
+            drop(receiver);
+            assert_eq!(pending.await, InProcessNotificationDelivery::Closed);
+        })
+        .await
+        .expect("closed-consumer forwarding fixture exceeded its bound");
+    }
+}
